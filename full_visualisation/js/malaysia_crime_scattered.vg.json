{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": 300,
  "background": "white",
  "data": {
    "url": "data/scattered_data/crime_unemployment_state.csv"
  },
  "transform": [
    {
      "filter": "datum.crimes_per_10k_population != null && datum.unemployment_rate != null && datum.category != null"
    }
  ],
  "mark": {
    "type": "circle",
    "size": 80,
    "opacity": 0.7,
    "stroke": "grey",
    "strokeWidth": 1.5
  },
  "encoding": {
    "x": {
      "field": "crimes_per_10k_population",
      "type": "quantitative",
      "title": "Crime per 10K Population",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "values": [0, 20, 40, 60, 80, 100],
        "grid": true
      }
    },
    "y": {
      "field": "unemployment_rate",
      "type": "quantitative",
      "title": "Unemployment Rate (%)",
      "scale": {
        "domain": [0, 10]
      },
      "axis": {
        "values": [0, 2, 4, 6, 8, 10],
        "grid": true
      }
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "title": "Region",
      "scale": {
        "domain": [
          "East Malaysia",
          "East Coast Malaysia",
          "South Malaysia",
          "Central Malaysia",
          "North Malaysia"
        ],
        "range": [
          "#1f78b4",
          "#ff7f00",
          "#6a3d9a",
          "#e31a89",
          "#b15928"
        ]
      },
      "legend": {
        "orient": "right",
        "titleFontSize": 12,
        "labelFontSize": 10,
        "symbolSize": 80
      }
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State",
        "type": "nominal"
      },
      {
        "field": "year",
        "title": "Year",
        "type": "ordinal"
      },
      {
        "field": "crimes_per_10k_population",
        "title": "Crime per 10K",
        "type": "quantitative",
        "format": ".2f"
      },
      {
        "field": "unemployment_rate",
        "title": "Unemployment Rate (%)",
        "type": "quantitative",
        "format": ".1f"
      },
      {
        "field": "total_crimes",
        "title": "Total Crimes",
        "type": "quantitative",
        "format": ","
      }
    ]
  },
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
