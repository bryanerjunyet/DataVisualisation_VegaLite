{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": 300,
  "background": "white",
  "title": {
    "text": "Crime Rate vs Unemployment by State",
    "fontSize": 16,
    "anchor": "start",
    "offset": 15
  },
  "data": {
    "url": "data/scattered_data/crime_district_cleaned.csv"
  },
  "transform": [
    {
      "calculate": "datum.state_year",
      "as": "state_year_key"
    },
    {
      "lookup": "state_year_key",
      "from": {
        "data": {
          "url": "data/scattered_data/unemployment_state.csv",
          "transform": [
            {
              "calculate": "trim(datum['State/Country'])",
              "as": "unemp_state"
            },
            {
              "calculate": "datum.unemp_state == 'W.P Kuala Lumpur' ? 'W.P. Kuala Lumpur' : datum.unemp_state == 'W.P Labuan' ? 'W.P. Labuan' : datum.unemp_state == 'W.P Putrajaya' ? 'W.P. Putrajaya' : datum.unemp_state",
              "as": "normalized_unemp_state"
            },
            {
              "calculate": "normalized_unemp_state + '-' + datum.Year",
              "as": "state_year_key"
            },
            {
              "calculate": "toNumber(trim(datum[' Unemployment Rate (Percentage) ']))",
              "as": "unemployment_rate_value"
            }
          ]
        },
        "key": "state_year_key",
        "fields": ["unemployment_rate_value"]
      },
      "as": "unemployment_rate"
    },
    {
      "filter": "datum.unemployment_rate != null && datum.unemployment_rate > 0"
    }
  ],
  "mark": {
    "type": "circle",
    "size": 60,
    "opacity": 0.6,
    "fill": "#1f77b4",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "crimes_per_10k_population",
      "type": "quantitative",
      "title": "Crime Rate per 10K Population",
      "scale": {
        "domain": [0, 110]
      }
    },
    "y": {
      "field": "unemployment_rate",
      "type": "quantitative",
      "title": "Unemployment Rate (%)",
      "scale": {
        "domain": [0, 9]
      }
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State"
      },
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "crimes_per_10k_population",
        "title": "Crime Rate per 10K",
        "format": ".2f"
      },
      {
        "field": "unemployment_rate",
        "title": "Unemployment Rate (%)",
        "format": ".1f"
      },
      {
        "field": "total_crimes",
        "title": "Total Crimes",
        "format": ","
      }
    ]
  },
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
