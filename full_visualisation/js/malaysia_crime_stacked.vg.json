{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": 300,
  "background": "white",
  "data": {
    "url": "data/bar_data/crime_district_cleaned.csv"
  },
  "title": {
    "text": "Reported Crimes Across Years",
    "fontSize": 16,
    "anchor": "start",
    "offset": 15
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "datum.Cases / 1000",
          "as": "Cases_K"
        }
      ],
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Cases_K",
          "type": "quantitative",
          "aggregate": "sum",
          "title": "Reported Cases ('000)",
          "scale": {
            "type": "linear"
          },
          "axis": {
            "format": ".0f",
            "tickCount": 6
          }
        },
        "color": {
          "field": "Crime_Type",
          "type": "nominal",
          "title": "Crime category",
          "scale": {
            "domain": [
              "Property",
              "Assault"
            ],
            "range": [
              "#ff8c00",
              "#8b4513"
            ]
          }
        },
        "order": {
          "field": "Crime_Type",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "Year",
            "title": "Year"
          },
          {
            "field": "Crime_Type",
            "title": "Category"
          },
          {
            "field": "Cases",
            "title": "Cases",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2016"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Cases",
              "as": "total_cases"
            }
          ],
          "groupby": [
            "Year"
          ]
        },
        {
          "calculate": "(datum.total_cases / 1000) - 20",
          "as": "label_y"
        },
        {
          "calculate": "(datum.total_cases / 1000) + 15",
          "as": "line_end"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeWidth": 1.5,
        "x2Offset": 80
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "x2": {
          "field": "Year",
          "type": "ordinal"
        },
        "y2": {
          "field": "line_end",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2016"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Cases",
              "as": "total_cases"
            }
          ],
          "groupby": [
            "Year"
          ]
        },
        {
          "calculate": "(datum.total_cases / 1000) + 15",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 10,
        "fontWeight": "bold",
        "fill": "#333333",
        "dx": 85
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "value": "Total reported crime peaked at 200K+ cases in 2016"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2020"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Cases",
              "as": "total_cases"
            }
          ],
          "groupby": [
            "Year"
          ]
        },
        {
          "calculate": "(datum.total_cases / 1000) + 50",
          "as": "label_y"
        },
        {
          "calculate": "(datum.total_cases / 1000) ",
          "as": "line_end"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "y2": {
          "field": "line_end",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2020"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Cases",
              "as": "total_cases"
            }
          ],
          "groupby": [
            "Year"
          ]
        },
        {
          "calculate": "(datum.total_cases / 1000) + 55",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "fontSize": 9,
        "fontWeight": "bold",
        "fill": "#333333"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "value": "a 19% drop in assault & 22% drop in property crimes"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2020"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Cases",
              "as": "total_cases"
            }
          ],
          "groupby": [
            "Year"
          ]
        },
        {
          "calculate": "(datum.total_cases / 1000) + 65",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "fontSize": 9,
        "fontWeight": "bold",
        "fill": "#333333"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "value": "In 2020, COVID-19 movement restriction led to"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "padding": {
      "top": 10,
      "bottom": 0,
      "left": 0,
      "right": 0
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "titleFontSize": 11,
      "labelFontSize": 10
    }
  }
}
